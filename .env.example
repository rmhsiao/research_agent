# LLM — OpenAI-compatible endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
COORDINATOR_MODEL=gpt-4o
WEB_SEARCH_MODEL=gpt-4o-mini
REPORT_MODEL=gpt-4o-mini

# Coordinator memory
# Recent conversation rounds kept verbatim in the assembled context window.
MEMORY_RECENT_ROUNDS=5
# Summarize overflow rounds into the session summary every N rounds.
MEMORY_COMPRESS_EVERY_ROUNDS=5
# Directory where per-session memory is persisted.
MEMORY_DATA_DIR=./data/sessions

# Web search backend
TAVILY_API_KEY=tvly-...

# API base URL the UI calls
API_BASE_URL=http://localhost:8000
